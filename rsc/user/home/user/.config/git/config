[core]
	pager = less -S
[init]
	defaultBranch = main
[grep]
	patternType = perl
[receive]
	denyCurrentBranch = ignore
[advice]
	detachedHead = false
	skippedCherryPicks = false
[merge]
	tool = vimdiff4way
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "vimdiff4way"]
	cmd = nvim -d -c \"wincmd J\" -c \"0\" -c \"/<<<<<<< \" $MERGED $LOCAL $BASE $REMOTE
[diff]
	tool = vimdiff
	noprefix = true
	colorMoved = dimmed-zebra
[gc]
	# Keep every object an agent creates, so a commit recorded before a turn
	# stays diffable after an amend, a reset or a rebase. Automatic repacking
	# still runs; only the pruning of unreachable objects is suppressed.
	pruneExpire = never
	reflogExpireUnreachable = never
[pull]
	rebase = true
[credential "https://github.com"]
	helper = /usr/local/bin/git-credential-github
[alias]
	br = branch
	ci = commit
	co = checkout
	st = status --ignore-submodule=all -sb
